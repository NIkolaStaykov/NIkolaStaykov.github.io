---
import { site } from '../config';

/**
 * Icon links. Icons rather than text labels keep the identity block quiet —
 * the name should be the only loud thing above the fold.
 */
const icons: Record<string, string> = {
  GitHub:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.111.82-.261.82-.577 0-.285-.011-1.04-.016-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.744.084-.729.084-.729 1.205.085 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.304-5.467-1.333-5.467-5.93 0-1.31.468-2.381 1.236-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23A11.47 11.47 0 0 1 12 6.099c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.873.119 3.176.77.84 1.235 1.911 1.235 3.221 0 4.608-2.807 5.624-5.479 5.921.43.371.823 1.102.823 2.222 0 1.604-.015 2.896-.015 3.289 0 .319.216.694.825.576C20.565 22.092 24 17.596 24 12.297c0-6.627-5.373-12-12-12',
  LinkedIn:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  'Google Scholar':
    'M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269ZM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14Z',
  ORCID:
    'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0ZM7.369 4.378a.87.87 0 1 1 0 1.74.87.87 0 0 1 0-1.74Zm-.87 3.065h1.74v10.11h-1.74V7.443Zm4.088 0h3.93c3.74 0 5.382 2.674 5.382 5.057 0 2.59-2.025 5.053-5.365 5.053h-3.947V7.443Zm1.74 1.57v6.97h2.06c2.936 0 3.606-2.23 3.606-3.483 0-2.04-1.3-3.487-3.685-3.487h-1.98Z',
  Email:
    'M1.5 4.5h21v15h-21v-15Zm1.8 1.8v.28l8.7 5.5 8.7-5.5V6.3H3.3Zm17.4 2.62-8.7 5.5-8.7-5.5v8.78h17.4V8.92Z',
};

/*
 * No mail icon: the address is written out above instead. Scholar takes its
 * place — it renders only once site.profiles.scholar is set.
 */
const entries = [
  ['GitHub', site.profiles.github],
  ['Google Scholar', site.profiles.scholar],
  ['LinkedIn', site.profiles.linkedin],
  ['ORCID', site.profiles.orcid],
].filter(([, href]) => Boolean(href)) as [string, string][];
---

<div class="social" aria-label="Profile links">
  {entries.map(([label, href]) => (
    <a href={href} title={label} aria-label={label} rel="me noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[label]} /></svg>
    </a>
  ))}
</div>

<style>
  .social { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-4); }
  .social a {
    color: var(--text-muted);
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px;
    text-decoration: none;
    transition: color var(--transition), transform var(--transition);
  }
  .social a:hover { color: var(--accent); transform: translateY(-1px); }
  .social svg { width: 21px; height: 21px; display: block; fill: currentColor; }
</style>
